<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Payment Failed | LuxeCarry</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />

    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />

    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <%- include('../partials/user/navbar') %>

    <div class="order-success-wrapper">
      <div class="success-card payment-failed-card">
        <!-- Failed Icon -->
        <div class="payment-failed-icon">
          <i class="fa-solid fa-xmark"></i>
        </div>

        <!-- Heading -->
        <h1 class="success-title">Payment Failed</h1>

        <p class="success-subtitle">
          Your payment could not be completed. Please retry the payment or continue later.
        </p>

        <!-- Summary -->
        <div class="order-summary-box">
          <div class="summary-row">
            <span class="summary-label"> Payment Method </span>

            <span class="summary-value"> Razorpay </span>
          </div>

          <div class="summary-row">
            <span class="summary-label"> Status </span>

            <span class="summary-value text-danger"> Failed </span>
          </div>
        </div>

        <!-- Buttons -->
        <div class="success-actions">
          <a href="/user/checkout" class="btn-order-primary"> Retry Payment </a>

          <a href="/user/cart" class="btn-order-outline"> Cancel </a>
        </div>
      </div>
    </div>

    <%- include('../partials/user/footer-short') %>
  </body>
</html>
