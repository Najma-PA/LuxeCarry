<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Add Address | LuxeCarry</title>

    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
    />
    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/address.css" />
  </head>

  <body>
    <!-- Navbar -->
    <%- include("../partials/user/navbar") %>

    <div class="container account-container my-5">
      <div class="address-card">
        <h3 class="page-title">Add New Address</h3>
        <p class="page-sub">Enter your shipping details for exclusive luxury delivery.</p>

        <form
          id="addressForm"
          action="/user/addAddress<%= typeof redirect !== 'undefined' && redirect === 'checkout' ? '?redirect=checkout' : '' %>"
          method="POST"
        >
          <div class="row mb-3">
            <div class="col-md-6">
              <label class="form-label">Full Name</label>
              <input
                type="text"
                class="form-control"
                id="name"
                name="name"
                value="<%= formData?.name ||'' %>"
              />

              <small class="text-danger" id="nameError"> <%= errors.name || '' %> </small>
            </div>

            <div class="col-md-6">
              <label class="form-label">Phone Number</label>
              <input
                type="text"
                class="form-control"
                id="phone"
                name="phone"
                value="<%= formData?.phone ||'' %>"
              />

              <small class="text-danger" id="phoneError"> <%= errors.phone || '' %> </small>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label">Street Address</label>
            <input
              type="text"
              class="form-control"
              id="street"
              name="street"
              value="<%= formData?.street || '' %>"
            />

            <small class="text-danger" id="streetError"> <%= errors.street ||''%> </small>
          </div>

          <div class="row mb-3">
            <div class="col-md-4">
              <label class="form-label">Pincode</label>
              <input
                type="text"
                class="form-control"
                id="pincode"
                name="pincode"
                value="<%= formData?.pincode || '' %>"
              />

              <small class="text-danger" id="pincodeError"> <%= errors.pincode %> </small>
            </div>
            <div class="col-md-4">
              <label class="form-label">City</label>
              <input
                type="text"
                class="form-control"
                id="city"
                name="city"
                value="<%= formData?.city || '' %>"
                readonly
              />

              <small class="text-danger" id="cityError"> <%= errors.city ||'' %> </small>
            </div>
             <div class="col-md-4">
              <label class="form-label">State</label>
              <input
                type="text"
                class="form-control"
                id="state"
                name="state"
                value="<%= formData?.state || '' %>"
                readonly
              />

              <small class="text-danger" id="stateError"> <%= errors.state || '' %> </small>
            </div>
          </div>

          <div class="mb-3">
           
            <div class="col-md-4">
              <label class="form-label">Country</label>

              <input type="text" name="country" value="India" readonly />
            </div>
          
          <div class="form-check mb-4">
            <input class="form-check-input" type="checkbox" name="defaultAddress" />
            <label class="form-check-label"> Set as default address </label>
          </div>
          <div class="address-actions">
            <button type="submit" class="edit-btn">Save Address</button>
            <a
              href="<%= typeof redirect !== 'undefined' && redirect === 'checkout' ? '/user/checkout' : '/user/addresses' %>"
              class="cancel-btn"
              >Cancel</a
            >
          </div>
        </form>
      </div>
    </div>

    <%- include("../partials/user/footer-short") %>

    <script src="/js/user/addressValidation.js"></script>
  </body>
</html>
