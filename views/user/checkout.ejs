<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - LuxeCarry</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

</head>
<body>

<%- include('../partials/user/navbar') %>

<div class="checkout-container">
    <div class="checkout-header">
        <h1>Checkout</h1>
    </div>

    <form id="checkoutForm" action="/user/order-place" method="POST">
        <div class="row g-3">
            <!-- LEFT COLUMN: Shipping & Payment -->
            <div class="col-lg-8">
                
                <!-- Shipping Address -->
                <div class="section-title">
                    <i class="fa-solid fa-location-dot"></i> Shipping Address
                </div>

                <div class="checkout-form-card">
                    <% 
                    const selectedAddress = addresses && addresses.length > 0 
                        ? addresses.find(addr => addr.isDefault) || addresses[0] 
                        : null; 
                    %>
                    <input type="hidden" name="addressId" id="selectedAddressId" value="<%= selectedAddress ? selectedAddress._id : '' %>">

                    <% if (addresses && addresses.length > 0) { %>
                        <div class="address-cards-grid row g-3">
                            <% addresses.forEach(addr => { %>
                                <div class="col-md-6">
                                    <div class="lc-checkout-address-card <%= selectedAddress && selectedAddress._id.toString() === addr._id.toString() ? 'selected' : '' %>" 
                                         data-id="<%= addr._id %>"
                                         onclick="selectCheckoutAddress('<%= addr._id %>')">
                                        <div class="lc-address-card-header d-flex justify-content-between align-items-start">
                                            <h6 class="mb-1 text-truncate fw-bold" style="max-width: 70%;" title="<%= addr.name %>"><%= addr.name %></h6>
                                            <% if (addr.isDefault) { %>
                                                <span class="badge lc-badge-default">Default</span>
                                            <% } %>
                                        </div>
                                        <div class="lc-address-card-body mt-2">
                                            <p class="mb-1 text-muted small"><i class="fa fa-phone me-1"></i> <%= addr.phone %></p>
                                            <p class="mb-1 text-muted small text-truncate"><i class="fa fa-map-marker-alt me-1"></i> <%= addr.street %></p>
                                            <p class="mb-1 text-muted small text-truncate"><%= addr.city %>, <%= addr.state %> - <%= addr.pincode %></p>
                                            <p class="mb-0 text-muted small"><%= addr.country || 'India' %></p>
                                        </div>
                                        <div class="lc-address-card-footer mt-3 pt-2 border-top d-flex justify-content-end">
                                            <a href="/user/editAddress/<%= addr._id %>?redirect=checkout" 
                                               class="btn btn-sm btn-outline-secondary py-1 px-3 rounded-pill fw-bold" 
                                               style="font-size: 11px;"
                                               onclick="event.stopPropagation();">
                                                <i class="fa fa-edit me-1"></i> Edit
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <div class="mt-4 pt-2 border-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <a href="/user/addAddress?redirect=checkout" class="btn btn-theme-premium">
                                <i class="fa fa-plus me-1"></i> Add New Address
                            </a>
                           <!-- <a href="/user/addresses?redirect=checkout" class="btn btn-link text-decoration-none text-muted fw-bold" style="font-size: 13px;">
                                <i class="fa-solid fa-location-dot me-1"></i> Manage Addresses
                            </a>-->
                        </div>
                    <% } else { %>
                        <!-- No Saved Address Scenario -->
                        <div class="text-center py-5">
                            <div class="mb-3 text-muted">
                                <i class="fa-solid fa-map-location-dot" style="font-size: 3.5rem; color: #b78846; opacity: 0.8;"></i>
                            </div>
                            <h5 class="fw-bold mb-2">No saved addresses found</h5>
                            <p class="text-muted small mb-4" style="max-width: 320px; margin: 0 auto;">Please add a shipping address to proceed with your premium order placement.</p>
                            <a href="/user/addAddress?redirect=checkout" class="btn btn-theme-premium px-4">
                                <i class="fa fa-plus me-1"></i> Add Address
                            </a>
                        </div>
                    <% } %>
                </div>

                <!-- Payment Method -->
                <div class="section-title">
                    <i class="fa-solid fa-credit-card"></i> Payment Method
                </div>

                <div class="checkout-form-card">
                    <div class="payment-selection">
                        
                        <div class="payment-method-item">
                            <input type="radio" name="paymentMethod" id="razorpay" value="RAZORPAY" checked>
                            <label for="razorpay">
                                Razorpay
                                <i class="fa-regular fa-credit-card"></i>
                            </label>
                        </div>

                        <div class="payment-method-item">
                            <input type="radio" name="paymentMethod" id="cod" value="COD">
                            <label for="cod">
                                Cash on Delivery
                                <i class="fa-solid fa-money-bill-transfer"></i>
                            </label>
                        </div>

                        <div class="payment-method-item">
                            <input type="radio" name="paymentMethod" id="wallet" value="WALLET">
                            <label for="wallet">
                                Digital Wallet
                                <i class="fa-solid fa-wallet"></i>
                                 <small class="text-success d-block mt-1">
                                    Balance: ₹<%= wallet.balance.toFixed(2) %>
                                 </small>
                            </label>
                        </div>

                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN: Order Summary -->
            <div class="col-lg-4">
                <div class="order-summary-card">
                    <h5>Order Summary</h5>

                    <div class="summary-item-list">
                        <% cart.items.forEach(item => { %>
                            <div class="summary-item-row">
                                <img src="<%=item.product?.thumbnail.url || '/images/placeholder.jpg' %>" alt="<%= item.product.name %>">
                                <div class="summary-item-details">
                                    <div class="name"><%= item.product.name %></div>
                                    <div class="attr">
                                        Color: <%= item.variantDetail ? item.variantDetail.value : '-' %> | Qty: <%= item.quantity %>
                                    </div>
                                    <div class="price">₹<%= item.finalPrice.toLocaleString() %></div>
                                    <div id="stock-error-<%= item._id %>"
                             class="text-danger fw-bold mb-2"
                             style="font-size: 10px;">
                        </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                    <!-- coupon  -->


                    <div class="coupon-section">

                        <div class="
                            d-flex
                            justify-content-between
                            align-items-center
                            mb-3
                        ">

                            <div class="form-label mb-0">

                                Available Coupons

                            </div>

                            <a
                                href="/user/coupons"
                                class="text-decoration-none fw-bold small">

                                View All

                            </a>

                        </div>

                        <!-- COUPON SELECT -->

                        <div class="coupon-input-group">

                            <select
                                id="couponSelect"
                                class="form-select">

                                <option value="">

                                    Select Coupon

                                </option>

                                <% if (coupons && coupons.length > 0) { %>

                                    <% coupons.forEach(coupon => { %>

                                        <option
                                            value="<%= coupon.code %>">

                                            <%= coupon.code %>

                                            -

                                            <% if (
                                                coupon.discountType ===
                                                'PERCENTAGE'
                                            ) { %>

                                                <%= coupon.discountValue %>% OFF

                                            <% } else { %>

                                                ₹<%= coupon.discountValue %> OFF

                                            <% } %>

                                        </option>

                                    <% }) %>

                                <% } %>

                            </select>

                            <!-- APPLY -->

                            <button
                                type="button"
                                id="applyCouponBtn"
                                class="btn-apply-coupon">

                                Apply

                            </button>

                        </div>

                        <!-- APPLIED COUPON -->

                        <div
                            id="appliedCouponBox"
                            class="coupon-message d-none mt-3">

                            <div class="
                                d-flex
                                justify-content-between
                                align-items-center
                            ">

                                <div>

                                    <i class="
                                        fa-solid
                                        fa-circle-check
                                        text-success
                                    "></i>

                                    <span
                                        id="appliedCouponCode">

                                    </span>

                                    applied successfully

                                </div>

                                <button
                                    type="button"
                                    id="removeCouponBtn"
                                    class="
                                        btn
                                        btn-sm
                                        btn-outline-danger
                                    ">

                                    Remove

                                </button>

                            </div>

                        </div>

                        <!-- HIDDEN INPUT -->

                        <input
                            type="hidden"
                            id="couponCodeInput"
                            name="couponCode">

                    </div>


                   <!--<div class="coupon-section">
                        <div class="form-label">Have a coupon code?</div>
                        <div class="coupon-input-group">
                            <input type="text" id="couponCode" class="form-control" placeholder="WELCOME10">
                            <button type="button" class="btn-apply-coupon">Apply</button>
                        </div>
                        <div class="coupon-message" id="couponMsg">
                            <i class="fa-solid fa-circle-check"></i> Coupon WELCOME10 applied successfully!
                        </div>
                    </div>-->
                
                    <div class="summary-totals">
                        <div class="total-row">
                            <span>Subtotal</span>
                            <span>₹<%= cart.subtotal.toLocaleString() %>.00</span>
                        </div>
                        <div class="total-row discount">
                            <span>Product Discount </span>
                            <span>-₹<%= cart.totalDiscount.toLocaleString() %>.00</span>
                        </div>
                        <div class="total-row discount"> 
                            <span> Coupon Discount </span> 
                            <span id="couponDiscountText"> ₹0.00 </span> 
                        </div>
                        <div class="total-row">
                            <span>Shipping</span>
                            <span class="text-success fw-bold">Free</span>
                        </div>

                        <div class="total-row grand-total">
                            <span>Total</span>
                            <span id="finalTotalText">₹<%= finalTotal.toLocaleString() %></span>
                        </div>
                    </div>

                    <button type="submit" class="btn-place-order">
                        Place Order <i class="fa-solid fa-arrow-right"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<%- include('../partials/user/footer-short') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script>
    function selectCheckoutAddress(addressId) {
        // Update the hidden input value
        document.getElementById('selectedAddressId').value = addressId;
        
        // Remove selected class from all address cards
        document.querySelectorAll('.lc-checkout-address-card').forEach(card => {
            card.classList.remove('selected');
        });
        
        // Add selected class to the clicked address card
        const selectedCard = document.querySelector(`.lc-checkout-address-card[data-id="${addressId}"]`);
        if (selectedCard) {
            selectedCard.classList.add('selected');
        }
    }
    function clearStockErrors() {

    document.querySelectorAll('[id^="stock-error-"]').forEach(el => {
        el.innerHTML = '';
    });

}


function showStockErrors(errors) {

    errors.forEach(err => {

        const errorBox = document.getElementById(
            `stock-error-${err.id}`
        );

        if (errorBox) {

            errorBox.innerHTML = `
                <i class="fa-solid fa-circle-exclamation"></i>
                ${err.message}
            `;
        }
    });
       const firstError = document.querySelector(
        '[id^="stock-error-"]:not(:empty)'
    );

    if (firstError) {

        firstError.scrollIntoView({
            behavior: 'smooth',
            block: 'center'
        });
    }
}
    document.getElementById('checkoutForm')?.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const addressId = document.getElementById('selectedAddressId').value;
        if (!addressId) {
            Swal.fire({
                icon: 'warning',
                title: 'Shipping Address Required',
                text: 'Please add and select a shipping address before placing your order.',
                confirmButtonColor: '#b78846'
            });
            return;
        }

        const submitBtn = this.querySelector('button[type="submit"]');
        const originalText = submitBtn.innerHTML;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';
        submitBtn.disabled = true;

        try {
            const formData = new FormData(this);
            const data = Object.fromEntries(formData);
            
            const response = await fetch(this.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            
            const result = await response.json();
            if ( result.razorpay) {

    const options = {

        key: result.key,

        amount: result.amount,

        currency: result.currency,

        name: 'LuxeCarry',

        description: 'Order Payment',

        order_id: result.razorpayOrderId,

        handler: async function (response) {

            try {

                const verifyResponse =
                    await fetch(
                        '/user/verify-payment',
                        {

                            method: 'POST',

                            headers: {
                                'Content-Type':
                                    'application/json',
                            },

                            body: JSON.stringify({

                                razorpay_order_id:
                                    response.razorpay_order_id,

                                razorpay_payment_id:
                                    response.razorpay_payment_id,

                                razorpay_signature:
                                    response.razorpay_signature,

                                addressId,

                                paymentMethod:
                                    data.paymentMethod,

                                couponCode:
                                    couponCodeInput.value,

                            }),

                        }
                    );

                const verifyData =
                    await verifyResponse.json();

                if (verifyData.success) {

                    Swal.fire({

                        icon: 'success',

                        title:
                            'Payment Successful',

                        text:
                            'Order placed successfully',

                        timer: 2000,

                        showConfirmButton: false,

                    }).then(() => {

                        window.location.href =
                           `/user/order-success/${verifyData.orderId}`;

                    });

                } else {

                    Swal.fire({

                        icon: 'error',

                        title:
                            'Verification Failed',

                        text:
                            verifyData.message,

                    });

                }

            } catch (error) {

                console.error(error);

            }

        },

        theme: {
            color: '#b78846',
        },

    };

    const rzp = new Razorpay(options);
     rzp.on('payment.failed',function(){
        Swal.fire({
            icon:'error',
            title:'Payment failed',
            text:'Your payment could not be completed'
        }).then(()=>{
            window.location.href='/user/payment-failure';
        });
     });

    rzp.open();

    return;

}


if (result.success) {

    Swal.fire({

        icon: 'success',

        title: 'Order Placed!',

        text:
            result.message ||
            'Your order has been placed successfully.',

        showConfirmButton: false,

        timer: 2000

    }).then(() => {

        window.location.href =
            result.data
                ? result.data.redirect
                : `/user/order-success/${result.orderId}`;

    });

}

           else {
                clearStockErrors();

                if (result.errors && Array.isArray(result.errors)) {

                    showStockErrors(result.errors);

                   /* Swal.fire({
                        icon: 'warning',
                        title: 'Some items need attention',
                        text: 'Please review the highlighted products.',
                        confirmButtonColor: '#b78846'
                    });*/

                    return;
                }
/*
                Swal.fire({
                    icon: 'error',
                    title: 'Checkout Failed',
                    text: result.message || 'There was an issue processing your order.',
                    confirmButtonColor: '#b78846'
                });*/
                /*Swal.fire({
                    icon: 'error',
                    title: 'Checkout Failed',
                    text: result.message || 'There was an issue processing your order.',
                    confirmButtonColor: '#b78846'
                }).then(() => {
                    if (result.redirect) {
                        window.location.href = result.redirect;
                    }
                });*/
            }
        } catch (error) {
            console.error(error);
            Swal.fire({
                icon: 'error',
                title: 'Network Error',
                text: 'An unexpected error occurred while placing your order.',
                confirmButtonColor: '#b78846'
            });
        } finally {
            submitBtn.innerHTML = originalText;
            submitBtn.disabled = false;
        }
        
    });



let appliedCoupon = null;

const subtotal = <%= finalTotal %>;

const couponSelect =
  document.getElementById(
    'couponSelect'
  );

const applyCouponBtn =
  document.getElementById(
    'applyCouponBtn'
  );

const removeCouponBtn =
  document.getElementById(
    'removeCouponBtn'
  );

const appliedCouponBox =
  document.getElementById(
    'appliedCouponBox'
  );

const appliedCouponCode =
  document.getElementById(
    'appliedCouponCode'
  );

const couponDiscountText =
  document.getElementById(
    'couponDiscountText'
  );

const finalTotalText =
  document.getElementById(
    'finalTotalText'
  );

const couponCodeInput =
  document.getElementById(
    'couponCodeInput'
  );



applyCouponBtn?.addEventListener(
  'click',
  async () => {

  
    if (appliedCoupon) {

      Swal.fire({

        icon: 'warning',

        title:
          'Coupon Already Applied',

        text:
          'Remove existing coupon first',

        confirmButtonColor:
          '#b78846',

      });

      return;

    }

    const couponCode =
      couponSelect.value;

    if (!couponCode) {

      Swal.fire({

        icon: 'warning',

        title:
          'Select Coupon',

        text:
          'Please select a coupon',

        confirmButtonColor:
          '#b78846',

      });

      return;

    }

    try {

      const response =
        await fetch(
          '/user/apply-coupon',
          {

            method: 'POST',

            headers: {

              'Content-Type':
                'application/json',

            },

            body: JSON.stringify({

              couponCode,

            }),

          }
        );

      const data =
        await response.json();

      /*
      SUCCESS
      */

      if (data.success) {

        appliedCoupon =
          couponCode;

        couponCodeInput.value =
          couponCode;

        appliedCouponBox
          .classList
          .remove('d-none');

        appliedCouponCode.innerText =
          couponCode;

        couponDiscountText.innerText =
          `- ₹${data.discount.toFixed(2)}`;

        finalTotalText.innerText =
          `₹${data.finalTotal.toFixed(2)}`;

       /* Swal.fire({

          icon: 'success',

          title:
            'Coupon Applied',

          text:
            `${couponCode} applied successfully`,

          timer: 1500,

          showConfirmButton: false,

        });
*/
      } else {

        Swal.fire({

          icon: 'error',

          title:
            'Coupon Failed',

          text:
            data.message,

          confirmButtonColor:
            '#b78846',

        });

      }

    } catch (error) {

      console.error(error);

    }

  }
);



removeCouponBtn?.addEventListener(
  'click',
  () => {

    appliedCoupon = null;

    couponCodeInput.value = '';

    appliedCouponBox
      .classList
      .add('d-none');

    couponDiscountText.innerText =
      '₹0.00';

    finalTotalText.innerText =
      `₹${subtotal.toFixed(2)}`;

    couponSelect.value = '';

    Swal.fire({

      icon: 'success',

      title:
        'Coupon Removed',

      timer: 1200,

      showConfirmButton: false,

    });

  }
);


</script>
<%- include('../partials/flashAndToast') %>
</body>
</html>
