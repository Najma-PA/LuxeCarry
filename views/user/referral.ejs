<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Refer & Earn | LuxeCarry</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

<link rel="stylesheet" href="/css/style.css">

</head>

<body>

<%- include('../partials/user/navbar') %>

<div class="referral-page-wrapper">

<div class="container">

<div class="row">

    <%- include('../partials/user/sidebar', {
        user,
        activePage: 'referral'
    }) %>

    <div class="col-lg-9 col-md-8">

        <div class="referral-page-header">

            <h1 class="referral-page-title">
                Refer & Earn
            </h1>

            <p class="referral-page-subtitle">
                Invite your friends to LuxeCarry and earn wallet rewards on every successful referral.
            </p>

        </div>

        <div class="referral-info-card">

            <div class="referral-info-content">

                <div class="referral-info-icon">

                    <i class="fa-solid fa-circle-question"></i>

                </div>

                <div>

                    <h5 class="referral-info-title">
                        How it works?
                    </h5>

                    <p class="referral-info-text mb-0">

                        Your friend must use your referral code during checkout on their first order of ₹500 or more.
                        <br>
                        Your reward will be credited once the return period expires.

                    </p>

                </div>

            </div>

        </div>

        <div class="referral-main-card">

            <h2 class="referral-quote">
                "Sharing is the new luxury."
            </h2>

            <p class="referral-description">

                Your friends get
                <span class="referral-highlight">
                    ₹500
                </span>

                 as reward for their first order, and you earn

                <span class="referral-highlight">
                    ₹1000
                </span>

                in wallet rewards for every successful referral.

            </p>

            <div class="referral-code-label">

                YOUR REFERRAL CODE

            </div>

            <div class="referral-code-wrapper">

                <input
                    type="text"
                    id="referralCode"
                    class="referral-code-input"
                    value="<%= user.referralCode  || 'NOT GENERATEd'%>"
                    readonly
                >

                <button
                    class="referral-copy-btn"
                    onclick="copyReferralCode()"
                >

                    <i class="fa-regular fa-copy me-1"></i>

                    Copy Code

                </button>

            </div>
            <div class="mt-4">
                <div class="referral-code-label">
                    YOUR REFERRAL LINK 
                </div>
                <div class="referral-code-wrapper">
                    <input 
                    type="text"
                    id="referralLink"
                    class="referral-code-input"
                    value="<%= `${req.protocol}://${req.get('host')}/user/signup?ref=${user.referralCode}` %>"
                    readonly>
                    <button class="referral-copy-btn"
                        onclick="copyReferralLink()">
                        <i class="fa-regular fa-copy me-1"></i>
                        Copy Link 
                    </button>
                </div>
            </div>

        </div>

    </div>

</div>

</div>

</div>

<%- include('../partials/user/footer-short') %>

<script>

function copyReferralCode() {

    const input = document.getElementById('referralCode');

    navigator.clipboard.writeText(input.value);

    const button = document.querySelector('.referral-copy-btn');

    button.innerHTML = `
        <i class="fa-solid fa-check me-1"></i>
        Copied
    `;

    setTimeout(() => {

        button.innerHTML = `
            <i class="fa-regular fa-copy me-1"></i>
            Copy Code
        `;

    }, 2000);
}
function copyReferralLink(){
    const input=document.getElementById('referralLink');
    navigator.clipboard.writeText(input.value);
    const buttons=document.querySelectorAll('.referral-copy-btn');
    buttons[1].innerHTML=`<i class="fa-solid fa-check me-1"></i>
    Copied`;
    setTimeout(()=>{
        buttons[1].innerHTML=`<i class="fa-regular fa-copy me-1"></i>
        Copy Link`;
    },2000);
}

</script>

</body>
</html>