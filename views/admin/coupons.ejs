async function deleteCoupon(id) {
    const result = await Swal.fire({
        title: 'Delete this coupon?',
        text: 'This action cannot be undone.',
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#c26a00',
        cancelButtonColor: '#64748b',
        confirmButtonText: 'Yes, delete it!'
    });

    if (result.isConfirmed) {
        try {
            const response = await fetch(`/admin/coupons/${id}`, {
                method: 'DELETE',
            });

            const data = await response.json();

            if (data.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Deleted!',
                    text: 'Coupon has been deleted.',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire('Error', data.message || 'Failed to delete coupon', 'error');
            }
        } catch (error) {
            Swal.fire('Error', 'An unexpected error occurred', 'error');
        }
    }
}


async function toggleCoupon(id) {

    const response =
        await fetch(

            `/admin/coupons/${id}/toggle`,

            {
                method: 'PATCH',
            }
        );

    const data =
        await response.json();

    if (data.success) {

        location.reload();

    }

}

const addCouponForm =
    document.getElementById(
        'addCouponForm'
    );

const discountType =
    document.getElementById(
        'discountType'
    );

const maximumDiscountWrapper =
    document.getElementById(
        'maximumDiscountWrapper'
    );


// SHOW/HIDE MAX DISCOUNT

function toggleMaximumDiscount() {

    if (discountType.value === 'PERCENTAGE') {

        maximumDiscountWrapper.style.display =
            'block';

    } else {

        maximumDiscountWrapper.style.display =
            'none';

        document.getElementById(
            'maximumDiscount'
        ).value = '';

    }
}

toggleMaximumDiscount();

discountType.addEventListener(
    'change',
    toggleMaximumDiscount
);


// FORM VALIDATION

addCouponForm.addEventListener(
    'submit',
    function (e) {

        let isValid = true;

        // clear old errors

        document.querySelectorAll(
            '.text-danger'
        ).forEach(el => {
            el.innerText = '';
        });


        const code =
            document.getElementById(
                'couponCode'
            ).value.trim();

        const discountValue =
            Number(
                document.getElementById(
                    'discountValue'
                ).value
            );

        const minimumOrderAmount =
            Number(
                document.getElementById(
                    'minimumOrderAmount'
                ).value
            );

        const maximumDiscount =
            Number(
                document.getElementById(
                    'maximumDiscount'
                ).value
            );

        const expiryDate =
            document.getElementById(
                'expiryDate'
            ).value;


        // COUPON CODE

        if (!code) {

            document.getElementById(
                'codeError'
            ).innerText =
                'Coupon code is required';

            isValid = false;
        }


        // DISCOUNT VALUE

        if (
            !discountValue ||
            discountValue <= 0
        ) {

            document.getElementById(
                'discountValueError'
            ).innerText =
                'Enter valid discount value';

            isValid = false;
        }


        // FIXED VALIDATION

        if (
            discountType.value === 'FIXED' &&
            minimumOrderAmount <= discountValue
        ) {

            document.getElementById(
                'minimumOrderError'
            ).innerText =
                'Minimum purchase must be greater than discount amount';

            isValid = false;
        }


        // PERCENTAGE VALIDATION

        if (
            discountType.value === 'PERCENTAGE'
        ) {

            if (discountValue > 100) {

                document.getElementById(
                    'discountValueError'
                ).innerText =
                    'Percentage cannot exceed 100';

                isValid = false;
            }

            if (
                !maximumDiscount ||
                maximumDiscount <= 0
            ) {

                document.getElementById(
                    'maximumDiscountError'
                ).innerText =
                    'Maximum discount required';

                isValid = false;
            }

        }


        // MIN ORDER

        if (
            !minimumOrderAmount ||
            minimumOrderAmount <= 0
        ) {

            document.getElementById(
                'minimumOrderError'
            ).innerText =
                'Enter valid minimum order amount';

            isValid = false;
        }


        // EXPIRY DATE

        const today =
            new Date()
                .toISOString()
                .split('T')[0];

        if (
            !expiryDate ||
            expiryDate < today
        ) {

            document.getElementById(
                'expiryDateError'
            ).innerText =
                'Select future date';

            isValid = false;
        }


        if (!isValid) {

            e.preventDefault();

        }

    }
);
</script>
</body>
