
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        Coupon Management | LuxeCarry
    </title>

    <!-- BOOTSTRAP -->

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <!-- FONT AWESOME -->

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- ADMIN CSS -->

    <link
        rel="stylesheet"
        href="/css/admin.css">

</head>

<body>

<div class="d-flex">

    <!-- SIDEBAR -->

    <%- include(
        '../partials/admin/sidebar',
        {
            active: 'coupons'
        }
    ) %>

    <!-- MAIN CONTENT -->

    <div class="main-content p-4 w-100">

        <!-- PAGE HEADER -->

        <div class="
            d-flex
            justify-content-between
            align-items-center
            mb-4
        ">

            <div>

                <h2 class="fw-bold mb-1">
                    Coupon Management
                </h2>

                <p class="text-muted mb-0">
                    Manage promotional offers and discounts
                </p>

            </div>

            <!-- ADD BUTTON -->

            <button
                class="btn-gold"

                data-bs-toggle="modal"

                data-bs-target="#addCouponModal">

                <i class="fa-solid fa-plus"></i>

                Add Coupon

            </button>

        </div>

        <!-- COUPON CARD -->

        <div class="card-shadow p-4">

            <!-- SEARCH + FILTER -->

            <div class="row g-3 mb-4">

                <div class="col-md-8">

                    <input
                        type="text"
                        class="form-control"
                        placeholder="Search coupons...">

                </div>

                <div class="col-md-4">

                    <select class="form-select">

                        <option value="">
                            All Status
                        </option>

                        <option value="active">
                            Active
                        </option>

                        <option value="inactive">
                            Inactive
                        </option>

                    </select>

                </div>

            </div>

            <!-- COUPON GRID -->

            <div class="row g-4">

                <% if (coupons.length > 0) { %>

                    <% coupons.forEach(coupon => { %>

                        <div class="col-lg-4 col-md-6">

                            <div class="admin-coupon-card">

                                <!-- LEFT -->

                                <div class="admin-coupon-left">

                                    <% if (coupon.discountType === 'PERCENTAGE') { %>

                                        <div class="admin-coupon-discount">

                                            <%= coupon.discountValue %>% OFF

                                        </div>

                                    <% } else { %>

                                        <div class="admin-coupon-discount">

                                            ₹<%= coupon.discountValue %> OFF

                                        </div>

                                    <% } %>

                                    <div class="admin-coupon-min">

                                        Min Purchase ₹<%= coupon.minimumOrderAmount %>

                                    </div>

                                </div>

                                <!-- RIGHT -->

                                <div class="admin-coupon-right">

                                    <!-- CODE -->

                                    <div class="admin-coupon-code">

                                        <%= coupon.code %>

                                    </div>

                                    <!-- EXPIRY -->

                                    <div class="admin-coupon-expiry">

                                        <i class="fa-regular fa-calendar"></i>

                                        Expires on

                                        <%= new Date(coupon.expiryDate).toLocaleDateString('en-IN') %>

                                    </div>

                                    <!-- STATUS -->

                                    <div class="mb-3">

                                        <% if (coupon.isActive) { %>

                                            <span class="badge bg-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger">
                                                Inactive
                                            </span>

                                        <% } %>

                                    </div>

                                    <!-- ACTIONS -->

                                    <div class="admin-coupon-actions">

                                        <!-- TOGGLE -->

                                        <button
                                            class="
                                                btn
                                                btn-sm
                                                <%= coupon.isActive
                                                    ? 'btn-outline-warning'
                                                    : 'btn-outline-success'
                                                %>
                                            ">

                                            <%= coupon.isActive
                                                ? 'Disable'
                                                : 'Enable'
                                            %>

                                        </button>

                                        <!-- DELETE -->

                                        <button
                                            class="
                                                btn
                                                btn-sm
                                                btn-outline-danger
                                            ">

                                            Delete

                                        </button>

                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <!-- EMPTY -->

                    <div class="col-12">

                        <div class="text-center py-5">

                            <i class="
                                fa-solid
                                fa-ticket
                                fa-3x
                                text-muted
                                mb-3
                            "></i>

                            <h5 class="fw-bold">

                                No Coupons Found

                            </h5>

                            <p class="text-muted">

                                Create your first coupon offer

                            </p>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>

<!-- =========================================
     ADD COUPON MODAL
========================================= -->

<div
    class="modal fade"
    id="addCouponModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body p-4">

                <!-- HEADER -->

                <div class="
                    d-flex
                    justify-content-between
                    align-items-center
                    mb-4
                ">

                    <h3 class="fw-bold mb-0">

                        Add Coupon

                    </h3>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <!-- FORM -->

                <form
                    action="/admin/coupons"
                    method="POST">

                    <!-- CODE -->

                    <div class="mb-3">

                        <label class="form-label">

                            Coupon Code

                        </label>

                        <input
                            type="text"

                            name="code"

                            class="form-control"

                            placeholder="WELCOME500"

                            required>

                    </div>

                    <!-- TYPE + VALUE -->

                    <div class="row">

                        <!-- TYPE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Coupon Type

                            </label>

                            <select
                                name="discountType"

                                class="form-select"

                                required>

                                <option value="FIXED">

                                    Fixed Amount

                                </option>

                                <option value="PERCENTAGE">

                                    Percentage

                                </option>

                            </select>

                        </div>

                        <!-- VALUE -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Discount Value

                            </label>

                            <input
                                type="number"

                                name="discountValue"

                                class="form-control"

                                required>

                        </div>

                    </div>

                    <!-- MIN + MAX -->

                    <div class="row">

                        <!-- MIN ORDER -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Minimum Order Amount

                            </label>

                            <input
                                type="number"

                                name="minimumOrderAmount"

                                class="form-control"

                                required>

                        </div>

                        <!-- MAX DISCOUNT -->

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Maximum Discount

                            </label>

                            <input
                                type="number"

                                name="maximumDiscount"

                                class="form-control"

                                placeholder="Optional">

                        </div>

                    </div>

                    <!-- EXPIRY -->

                    <div class="mb-4">

                        <label class="form-label">

                            Expiry Date

                        </label>

                        <input
                            type="date"

                            name="expiryDate"

                            class="form-control"

                            required>

                    </div>

                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="btn-gold w-100">

                        Save Coupon

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<!-- BOOTSTRAP -->

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

