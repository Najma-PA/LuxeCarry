
<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0">

    <title>
        Coupon Management | LuxeCarry
    </title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
        rel="stylesheet">

    <link
        rel="stylesheet"
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <link
        rel="stylesheet"
        href="/css/admin.css">

</head>

<body>

<div class="d-flex">

    <%- include(
        '../partials/admin/sidebar',
        {
            active: 'coupons'
        }
    ) %>


    <div class="main-content p-4 w-100">

        <div class="
            d-flex
            justify-content-between
            align-items-center
            mb-4
        ">

            <div>

                <h2 class="fw-bold mb-1">
                    Coupon Management
                </h2>

                <p class="text-muted mb-0">
                    Manage promotional offers and discounts
                </p>

            </div>


            <button
                class="btn-gold"

                data-bs-toggle="modal"

                data-bs-target="#addCouponModal">

                <i class="fa-solid fa-plus"></i>

                Add Coupon

            </button>

        </div>

        <div class="card-shadow p-4">

            <div class="row g-3 mb-4">

                <div class="col-md-8">

                    <input
                        type="text"
                        class="form-control"
                        placeholder="Search coupons...">

                </div>

                <div class="col-md-4">

                    <select class="form-select">

                        <option value="">
                            All Status
                        </option>

                        <option value="active">
                            Active
                        </option>

                        <option value="inactive">
                            Inactive
                        </option>

                    </select>

                </div>

            </div>

            

            <div class="row g-4">

                <% if (coupons.length > 0) { %>

                    <% coupons.forEach(coupon => { %>

                        <div class="col-lg-3 col-md-6">

                            <div class="admin-coupon-card <%= !coupon.isActive ? 'coupon-disabled' : '' %>">

                                <div class="admin-coupon-top">

                                    <i class="
                                        fa-solid
                                        <%= coupon.discountType === 'PERCENTAGE'
                                            ? 'fa-gift'
                                            : 'fa-gem' %>
                                    "></i>

                                </div>

                                <div class="admin-coupon-body">

                                    <h3 class="admin-coupon-code">
                                        <%= coupon.code %>
                                    </h3>

                                    <div class="admin-coupon-offer">

                                        <% if (coupon.discountType === 'PERCENTAGE') { %>
                                            <%= coupon.discountValue %>% OFF
                                        <% } else { %>
                                            ₹<%= coupon.discountValue %> OFF
                                        <% } %>

                                    </div>

                                    <div class="admin-coupon-meta">

                                        <p>
                                            <i class="fa-solid fa-cart-shopping"></i>
                                            Min order ₹<%= coupon.minimumOrderAmount %>
                                        </p>

                                        <p>
                                            <i class="fa-regular fa-calendar"></i>
                                            Expires on <%= new Date(coupon.expiryDate).toLocaleDateString('en-IN') %>
                                        </p>

                                        <p>
                                            <% if (coupon.isActive) { %>
                                                <span class="badge bg-success">Active</span>
                                            <% } else { %>
                                                <span class="badge bg-danger">Inactive</span>
                                            <% } %>
                                        </p>

                                    </div>

                                    <div class="admin-coupon-actions">

                                        <button
                                            onclick='openEditCouponModal(
                                                "<%= coupon._id %>",
                                                "<%= coupon.code %>",
                                                "<%= coupon.discountType %>",
                                                "<%= coupon.discountValue %>",
                                                "<%= coupon.minimumOrderAmount %>",
                                                "<%= coupon.maximumDiscount %>",
                                                "<%= new Date(coupon.expiryDate).toISOString().split("T")[0] %>"
                                            )'
                                            class="btn btn-outline-primary">
                                            Edit
                                        </button>
                                        <!--
                                        <button
                                            onclick="toggleCoupon('<%= coupon._id %>')"
                                            class="btn <%= coupon.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>">
                                            <%= coupon.isActive ? 'Disable' : 'Enable' %>
                                        </button>-->

                                        <%
                                        const today = new Date();
                                        today.setHours(0,0,0,0);

                                        const expiryDate = new Date(coupon.expiryDate);
                                        expiryDate.setHours(0,0,0,0);

                                        const isExpired = expiryDate < today;
                                        %>

                                        <% if (isExpired) { %>

                                           <span class="badge rounded-pill text-bg-dark px-3 py-2">
                                            Expired
                                           </span>

                                        <% } else { %>

                                            <button
                                                onclick="toggleCoupon('<%= coupon._id %>')"
                                                class="btn <%= coupon.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>">

                                                <%= coupon.isActive ? 'Disable' : 'Enable' %>

                                            </button>

                                        <% } %>
                                    </div>

                                </div>

                            </div>

                        </div>

                    <% }) %>

                <% } else { %>
                    <div class="col-12">

                        <div class="text-center py-5">

                            <i class="
                                fa-solid
                                fa-ticket
                                fa-3x
                                text-muted
                                mb-3
                            "></i>

                            <h5 class="fw-bold">

                                No Coupons Found

                            </h5>

                            <p class="text-muted">

                                Create your first coupon offer

                            </p>

                        </div>

                    </div>

                <% } %>

            </div>

        </div>

    </div>

</div>
<div
    class="modal fade"
    id="addCouponModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body p-4">
                <div class="
                    d-flex
                    justify-content-between
                    align-items-center
                    mb-4
                ">

                    <h3 class="fw-bold mb-0">

                        Add Coupon

                    </h3>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>

                <form
                    id="addCouponForm"
                    action="/admin/coupons" method="POST">
                    <div class="mb-3">

                        <label class="form-label">

                            Coupon Code

                        </label>

                        <input
                            type="text"

                            name="code"
                            id="couponCode"
                            class="form-control"

                            placeholder="WELCOME500">
                        <small id="codeError" class="text-danger"></small>

                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Coupon Type

                            </label>

                            <select
                                name="discountType"
                                id="discountType"
                                class="form-select">
                                <option value="FIXED">
                                    Fixed Amount
                                </option>
                                <option value="PERCENTAGE">
                                    Percentage
                                </option>
                            </select>
                            <small id="discountTypeError" class="text-danger"></small>

                        </div>
                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Discount Value

                            </label>

                            <input
                                type="number"
                                name="discountValue"
                                id="discountValue"
                                class="form-control">
                            <small id="discountValueError" class="text-danger"></small>

                        </div>

                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Minimum Order Amount

                            </label>

                            <input
                                type="number"

                                name="minimumOrderAmount"
                                id="minimumOrderAmount"
                                class="form-control">
                            <small id="minimumOrderError" class="text-danger"></small>
                        </div>
                        <div class="col-md-6 mb-3"
                        id="maximumDiscountWrapper"
                        style="display: none;">

                            <label class="form-label">

                                Maximum Discount

                            </label>

                            <input
                                type="number"

                                name="maximumDiscount"
                                id="maximumDiscount"
                                class="form-control">
                            <small id="maximumDiscountError" class="text-danger"></small>
                        </div>

                    </div>
                    <div class="mb-4">

                        <label class="form-label">

                            Expiry Date

                        </label>

                        <input
                            type="date"
                            name="expiryDate"
                            id="expiryDate"
                            class="form-control"
                            min="<%= new Date().toISOString().split('T')[0] %>">
                        <small id="expiryDateError" class="text-danger"></small>    

                    </div>
                    <button
                        type="submit"
                        class="btn-gold w-100">

                        Save Coupon

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<div
    class="modal fade"
    id="editCouponModal"
    tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-body p-4">
                <div class="
                    d-flex
                    justify-content-between
                    align-items-center
                    mb-4
                ">

                    <h4 class="fw-bold mb-0">

                        Edit Coupon

                    </h4>

                    <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                    </button>

                </div>
                <form id="editCouponForm">

                    <input
                        type="hidden"
                        id="editCouponId">
                    <div class="mb-3">

                        <label class="form-label">

                            Coupon Code

                        </label>

                        <input
                            type="text"
                            id="editCode"
                            class="form-control">
                        <small id="editCodeError" class="text-danger"></small>

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Coupon Type

                            </label>

                            <select
                                id="editDiscountType"
                                class="form-select">

                                <option value="FIXED">

                                    Fixed Amount

                                </option>

                                <option value="PERCENTAGE">

                                    Percentage

                                </option>

                            </select>

                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Discount Value

                            </label>

                            <input
                                type="number"
                                id="editDiscountValue"
                                class="form-control"
                                >
                            <small id="editDiscountValueError" class="text-danger"></small>

                        </div>

                    </div>


                    <div class="row">

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Minimum Order Amount

                            </label>

                            <input
                                type="number"
                                id="editMinimumAmount"
                                class="form-control">
                            <small id="editMinimumOrderError" class="text-danger"></small>
                        </div>

                        <div class="col-md-6 mb-3">

                            <label class="form-label">

                                Maximum Discount

                            </label>

                            <input
                                type="number"
                                id="editMaximumDiscount"
                                class="form-control">
                            <small id="editMaximumDiscountError" class="text-danger"></small>
                        </div>

                    </div>


                    <div class="mb-4">

                        <label class="form-label">

                            Expiry Date

                        </label>

                        <input
                            type="date"
                            id="editExpiryDate"
                            class="form-control"
                            min="<%= new Date().toISOString().split('T')[0] %>"
                            >
                        <small id="editExpiryDateError" class="text-danger"></small>    

                    </div>

                    <button
                        type="submit"
                        class="btn-gold w-100">

                        Update Coupon

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>



function openEditCouponModal(
    id,
    code,
    type,
    discountValue,
    minimumOrderAmount,
    maximumDiscount,
    expiryDate
) {

    document.getElementById(
        'editCouponId'
    ).value = id;

    document.getElementById(
        'editCode'
    ).value = code;

    document.getElementById(
        'editDiscountType'
    ).value = type;

    document.getElementById(
        'editDiscountValue'
    ).value = discountValue;

    document.getElementById(
        'editMinimumAmount'
    ).value = minimumOrderAmount;

    document.getElementById(
        'editMaximumDiscount'
    ).value = maximumDiscount;

    document.getElementById(
        'editExpiryDate'
    ).value = expiryDate;

    new bootstrap.Modal(
        document.getElementById(
            'editCouponModal'
        )
    ).show();
    toggleEditMaximumDiscount();

}

function toggleEditMaximumDiscount() {

    const discountType =
        document.getElementById(
            'editDiscountType'
        ).value;

    const maxDiscountWrapper =
        document.getElementById(
            'editMaximumDiscount'
        ).closest('.col-md-6');

    if (discountType === 'PERCENTAGE') {

        maxDiscountWrapper.style.display =
            'block';

    } else {

        maxDiscountWrapper.style.display =
            'none';

        document.getElementById(
            'editMaximumDiscount'
        ).value = '';
    }
}

document
.getElementById('editDiscountType')
.addEventListener(
    'change',
    toggleEditMaximumDiscount
);
document
.getElementById(
    'editCouponForm'
)
.addEventListener(
    'submit',

    async function (e) {

        e.preventDefault();

        let isValid = true;

        // CLEAR ERRORS

        document.querySelectorAll(
            '#editCouponModal .text-danger'
        ).forEach(el => {
            el.innerText = '';
        });

        const id =
            document.getElementById(
                'editCouponId'
            ).value;

        const code =
            document.getElementById(
                'editCode'
            ).value.trim();

        const discountType =
            document.getElementById(
                'editDiscountType'
            ).value;

        const discountValue =
            Number(
                document.getElementById(
                    'editDiscountValue'
                ).value
            );

        const minimumOrderAmount =
            Number(
                document.getElementById(
                    'editMinimumAmount'
                ).value
            );

        const maximumDiscount =
            Number(
                document.getElementById(
                    'editMaximumDiscount'
                ).value
            );

        const expiryDate =
            document.getElementById(
                'editExpiryDate'
            ).value;

        // CODE

        if (!code) {

            document.getElementById(
                'editCodeError'
            ).innerText =
                'Coupon code is required';

            isValid = false;
        }

        // DISCOUNT VALUE

        if (
            !discountValue ||
            discountValue <= 0
        ) {

            document.getElementById(
                'editDiscountValueError'
            ).innerText =
                'Enter valid discount value';

            isValid = false;
        }

        // MINIMUM ORDER

        if (
            !minimumOrderAmount ||
            minimumOrderAmount <= 0
        ) {

            document.getElementById(
                'editMinimumOrderError'
            ).innerText =
                'Enter valid minimum order amount';

            isValid = false;
        }

        // FIXED VALIDATION

        if (
            discountType === 'FIXED' &&
            minimumOrderAmount <= discountValue
        ) {

            document.getElementById(
                'editMinimumOrderError'
            ).innerText =
                'Minimum purchase must be greater than discount amount';

            isValid = false;
        }

        // PERCENTAGE VALIDATION

        if (
            discountType === 'PERCENTAGE'
        ) {

            if (discountValue > 100) {

                document.getElementById(
                    'editDiscountValueError'
                ).innerText =
                    'Percentage cannot exceed 100';

                isValid = false;
            }

            if (
                !maximumDiscount ||
                maximumDiscount <= 0
            ) {

                document.getElementById(
                    'editMaximumDiscountError'
                ).innerText =
                    'Maximum discount required';

                isValid = false;
            }
        }

        // EXPIRY DATE

        const today =
            new Date()
                .toISOString()
                .split('T')[0];

        if (
            !expiryDate ||
            expiryDate < today
        ) {

            document.getElementById(
                'editExpiryDateError'
            ).innerText =
                'Select future date';

            isValid = false;
        }

        if (!isValid) {
            return;
        }

        const response =
            await fetch(

                `/admin/coupons/${id}`,

                {

                    method: 'PUT',

                    headers: {

                        'Content-Type':
                            'application/json',

                    },

                    body: JSON.stringify({

                        code,

                        discountType,

                        discountValue,

                        minimumOrderAmount,

                        maximumDiscount,

                        expiryDate,

                    }),

                }
            );

        const data =
            await response.json();

        if (data.success) {

            location.reload();

        } else {

            Swal.fire(
                'Error',
                data.message,
                'error'
            );
        }
    }
);

