<!DOCTYPE html>
<html lang="en">
<head>

  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Admin Dashboard</title>

  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
    rel="stylesheet">

  <link
    rel="stylesheet"
    href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

  <link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<div class="d-flex">

  <!-- SIDEBAR -->
  <%- include('../partials/admin/sidebar', {
    active: 'dashboard'
  }) %>

  <!-- MAIN CONTENT -->
  <div class="main-content p-4 w-100">

    <!-- PAGE HEADER -->
    <div class="dashboard-header">

      <div>

        <h2 class="dashboard-title">
          Welcome back, Admin !!!
        </h2>

        <p class="dashboard-subtitle">
          Here’s what’s happening with LuxeCarry today.
        </p>

      </div>

      <!-- FILTER -->
      <div>

        <select class="dashboard-filter" onchange="window.location.href='/admin/dashboard?filter=' + encodeURIComponent(this.value)">
          <option value="All" <%= typeof filter !== 'undefined' && filter === 'All' ? 'selected' : '' %>>All Time</option>
          <option value="This Year" <%= typeof filter === 'undefined' || filter === 'This Year' ? 'selected' : '' %>>This Year</option>
          <option value="This Month" <%= typeof filter !== 'undefined' && filter === 'This Month' ? 'selected' : '' %>>This Month</option>
          <option value="Last 7 Days" <%= typeof filter !== 'undefined' && filter === 'Last 7 Days' ? 'selected' : '' %>>This Week</option>
        </select>

      </div>

    </div>

    <!-- KPI SECTION -->
    <div class="row g-3">

      <!-- TOTAL REVENUE -->
      <div class="col-xl-3 col-md-6">

        <div class="dashboard-stat-card">

          <div>

            <p class="dashboard-stat-label">
              Total Revenue
            </p>

            <h3 class="dashboard-stat-value">

              ₹<%= stats.totalRevenue.toLocaleString() %>

            </h3>

          </div>

          <div class="dashboard-stat-icon revenue">

            <i class="fa-solid fa-wallet"></i>

          </div>

        </div>

      </div>

      <!-- TOTAL ORDERS -->
      <div class="col-xl-3 col-md-6">

        <div class="dashboard-stat-card">

          <div>

            <p class="dashboard-stat-label">
              Total Orders
            </p>

            <h3 class="dashboard-stat-value">

              <%= stats.totalOrders %>

            </h3>

          </div>

          <div class="dashboard-stat-icon orders">

            <i class="fa-solid fa-box"></i>

          </div>

        </div>

      </div>

      <!-- TOTAL USERS -->
      <div class="col-xl-3 col-md-6">

        <div class="dashboard-stat-card">

          <div>

            <p class="dashboard-stat-label">
              Customers
            </p>

            <h3 class="dashboard-stat-value">

              <%= stats.totalUsers %>

            </h3>

          </div>

          <div class="dashboard-stat-icon users">

            <i class="fa-solid fa-users"></i>

          </div>

        </div>

      </div>

      <!-- TOTAL PRODUCTS -->
      <div class="col-xl-3 col-md-6">

        <div class="dashboard-stat-card">

          <div>

            <p class="dashboard-stat-label">
              Products
            </p>

            <h3 class="dashboard-stat-value">

              <%= stats.totalProducts %>

            </h3>

          </div>

          <div class="dashboard-stat-icon products">

            <i class="fa-solid fa-bag-shopping"></i>

          </div>

        </div>

      </div>

    </div>

    <!-- CHART SECTION -->
    <div class="row g-3 mt-2">

      <!-- SALES CHART -->
      <div class="col-lg-8">

        <div class="dashboard-card p-4 h-100">

          <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="dashboard-card-title">
              Revenue Overview
            </h5>

          </div>

          <canvas id="salesChart"></canvas>

        </div>

      </div>

      <!-- ORDER STATUS -->
      <div class="col-lg-4">

        <div class="dashboard-card p-4 h-100">

          <h5 class="dashboard-card-title mb-3">
            Order Status Summary
          </h5>

          <canvas id="orderStatusChart"></canvas>

        </div>

      </div>

    </div>

    <!-- LOWER SECTION -->
    <div class="row g-3 mt-2">
          <!-- TOP CATEGORIES CHART SECTION -->
      <div class="col-lg-4">
        <div class="dashboard-card p-4 h-100">
          <h5 class="dashboard-card-title mb-3">
            Top Categories (Units Sold)
          </h5>
          <div style="height: 300px; position: relative;">
            <canvas id="topCategoriesChart"></canvas>
          </div>
        </div>
      </div>

      <!-- TOP PRODUCTS -->
      <div class="col-lg-8">

        <div class="dashboard-card p-4">

          <div class="d-flex justify-content-between align-items-center mb-3">

            <h5 class="dashboard-card-title">
              Top Selling Products
            </h5>

          </div>

          <div class="top-products-list">

            <% topProducts.forEach((product,index)=>{ %>

              <div class="top-product-item">

                <div class="d-flex align-items-center gap-3">

                  <div class="top-product-rank">

                    <%= index + 1 %>

                  </div>

                  <img
                    src="<%= product.image %>"
                    class="top-product-image"
                  >

                  <div>

                    <h6 class="mb-0">

                      <%= product.name %>

                    </h6>

                    <small class="text-muted">

                      <%= product.totalSold %>
                      units sold

                    </small>

                  </div>

                </div>

                <h6 class="top-product-price mb-0">

                  ₹<%= product.revenue.toLocaleString() %>

                </h6>

              </div>

            <% }) %>

          </div>

        </div>

      </div>

  

    </div>

  </div>

</div>

<!-- CHART JS -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

  // SALES CHART

  const salesCtx =
    document.getElementById('salesChart');

  const monthlyRevData = <%- JSON.stringify(monthlyRevenue || []) %>;

  new Chart(salesCtx, {

    type: 'line',

    data: {

      labels: [
        'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'
      ],

      datasets: [{

        label: 'Revenue',

        data: monthlyRevData,

        borderColor: '#c59d5f',

        backgroundColor: 'rgba(197,157,95,0.1)',

        fill: true,

        tension: 0.4

      }]

    },

    options: {

      responsive: true,

      plugins: {

        legend: {
          display: false
        }

      }

    }

  });

  // ORDER STATUS CHART

  const orderCtx =
    document.getElementById('orderStatusChart');

  const orderStatusLabels = <%- JSON.stringify(orderStatusData?.labels || []) %>;
  const orderStatusValues = <%- JSON.stringify(orderStatusData?.data || []) %>;

  new Chart(orderCtx, {

    type: 'doughnut',

    data: {

      labels: orderStatusLabels,

      datasets: [{

        data: orderStatusValues,

      // Generate an array of colors based on the number of labels
      backgroundColor: orderStatusLabels.map((_, i) => {
        const colors = [
          '#c59d5f', '#6b7280', '#f0e6d7', '#4CAF50', '#2196F3', 
          '#FFC107', '#F44336', '#9C27B0', '#00BCD4', '#FF9800', 
          '#795548', '#607D8B', '#E91E63', '#3F51B5', '#8BC34A'
        ];
        return colors[i % colors.length];
      })
      }]

    },

    options: {

      responsive: true,

      plugins: {

        legend: {
          position: 'bottom'
        }

      }

    }

  });

  // TOP CATEGORIES BAR CHART
  const topCategoriesData = <%- JSON.stringify(topCategories || []) %>;
  const categoriesCtx = document.getElementById('topCategoriesChart');

  if (categoriesCtx && topCategoriesData.length > 0) {
    const categoryLabels = topCategoriesData.map(c => c.name || 'Unknown');
    const categoryValues = topCategoriesData.map(c => c.totalSold || 0);
    const bgColors= categoryValues.map((value,index)=>{
      if(index ===0){
        return '#c39d5f';
      }
      if(index===1){
        return '#6b7280';
      }
      return '#eadbc2';
    })
    new Chart(categoriesCtx, {
      type: 'bar',
      data: {
        labels: categoryLabels,
        datasets: [{
          label: 'Units Sold',
          data: categoryValues,
          backgroundColor: bgColors,
          borderRadius: 4
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: {
            display: false
          }
        },
        scales: {
          y: {
            beginAtZero: true,
            ticks: {
              precision: 0
            }
          }
        }
      }
    });
  }

</script>

</body>
</html>