
<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Sales Report</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

<link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<div class="d-flex">

  <%- include('../partials/admin/sidebar',{
    active:'reports'
  }) %>

  <div class="main-content w-100 p-4">

    <!-- HEADER -->
    <div class="report-header mb-4">

      <div>

        <h2 class="report-title mb-1">
          Sales Report
        </h2>

        <p class="report-subtitle mb-0">
          Track orders, revenue and discounts
        </p>

      </div>

      <div class="d-flex gap-2">
        
            <a
            href="/admin/reports/export/pdf?<%= new URLSearchParams(req.query).toString() %>"
            class="btn btn-danger report-btn">

            <i class="fa fa-file-pdf me-2"></i>
            Export PDF

            </a>

            <a
            href="/admin/reports/export/excel?<%= new URLSearchParams(req.query).toString() %>"
            class="btn btn-success report-btn">

            <i class="fa fa-file-excel me-2"></i>
            Export Excel

            </a>


        <!-- <a href="/admin/reports/export/pdf" 
           class="btn btn-danger report-btn">

          <i class="fa fa-file-pdf me-2"></i>
          Export PDF

        </a>

        <a href="/admin/reports/export/excel"
           class="btn btn-success report-btn">

          <i class="fa fa-file-excel me-2"></i>
          Export Excel

        </a>
-->
      </div>

    </div>

    <!-- FILTER -->
    <form method="GET"
          action="/admin/reports">

      <div class="report-filter-card mb-4">

        <div class="row g-3 align-items-end">

          <!-- SEARCH -->
          <div class="col-lg-4">

            <label class="report-label">
              Search
            </label>

            <input
              type="text"
              name="search"
              value="<%= search || '' %>"
              class="form-control report-input"
              placeholder="Search Order ID">

          </div>

          <!-- FILTER -->
          <div class="col-lg-3">

            <label class="report-label">
              Filter
            </label>

            <select
              name="reportFilter"
              class="form-select report-input">
                            
                <option value="Today"
                <%= reportFilter === 'Today' ? 'selected' : '' %>>
                Today
                </option>

                <option value="Last 7 Days"
                <%= reportFilter === 'Last 7 Days' ? 'selected' : '' %>>
                Last 7 Days
                </option>

                <option value="Last 30 Days"
                <%= reportFilter === 'Last 30 Days' ? 'selected' : '' %>>
                Last 30 Days
                </option>

                <option value="This Month"
                <%= reportFilter === 'This Month' ? 'selected' : '' %>>
                This Month
                </option>

                <option value="This Year"
                <%= reportFilter === 'This Year' ? 'selected' : '' %>>
                This Year
                </option>

                <option value="Custom"
                <%= reportFilter === 'Custom' ? 'selected' : '' %>>
                Custom Range
                </option>



             <!-- <option value="Today">
                Today
              </option>

              <option value="Last 7 Days">
                Last 7 Days
              </option>

              <option value="Last 30 Days">
                Last 30 Days
              </option>

              <option value="This Month">
                This Month
              </option>

              <option value="This Year">
                This Year
              </option>

              <option value="Custom">
                Custom Range
              </option>-->

            </select>

          </div>

          <!-- START DATE -->
          <div class="col-lg-2">

            <label class="report-label">
              From
            </label>

            <input
              type="date"
              name="customStartDate"
              class="form-control report-input">

          </div>

          <!-- END DATE -->
          <div class="col-lg-2">

            <label class="report-label">
              To
            </label>

            <input
              type="date"
              name="customEndDate"
              class="form-control report-input">

          </div>

          <!-- BUTTON -->
          <div class="col-lg-1">

            <button class="btn report-filter-btn w-100">

              Apply

            </button>

          </div>

        </div>

      </div>

    </form>

   

    <!-- TABLE -->
    <div class="report-table-card">

      <div class="table-responsive">

        <table class="table align-middle mb-0">

          <thead>

            <tr>

              <th>Order ID</th>

              <th>Date</th>

              <th>Customer</th>

              <th>Products</th>

              <th>Payment method</th>

              <th>Total</th>

            </tr>

          </thead>

          <tbody>

            <% if(orders.length > 0){ %>

              <% orders.forEach(order=>{ %>

                <tr>

                  <td class="fw-semibold">

                    #<%= order.orderId %>

                  </td>

                  <td>

                    <%= new Date(order.createdAt)
                    .toLocaleDateString('en-IN') %>

                  </td>

                  <td>

                    <div class="fw-semibold">

                      <%= order.userId?.name || 'User' %>

                    </div>

                    <small class="text-muted">

                      <%= order.userId?.email || '' %>

                    </small>

                  </td>

                  <td>
                    <small class="text-muted">
                      <% 
                        let pNames = '';
                        if (order.items && order.items.length > 0) {
                          pNames = order.items.map(i => i.productName).join(', ');
                          if (pNames.length > 40) {
                            pNames = pNames.substring(0, 40) + '...';
                          }
                        }
                      %>
                      <%= pNames %>
                    </small>
                  </td>

                  <td>
                    <span class="payment-badge">

                      <%= order.paymentMethod %>

                    </span>

                  </td>

                  <td class="fw-semibold text-success">
                    <% 
                      let totalRefunds = 0;
                      if (order.items && order.items.length > 0) {
                        order.items.forEach(item => {
                          totalRefunds += (item.refundAmount || 0);
                        });
                      }
                      let netTotal = (order.finalAmount || order.totalAmount || 0) - totalRefunds;
                      netTotal = Math.max(0, netTotal);
                    %>
                    ₹<%= Number(netTotal).toLocaleString() %>
                  </td>

                

                </tr>

              <% }) %>

            <% } else { %>

              <tr>

                <td colspan="7"
                    class="text-center py-5 text-muted">

                  No sales reports found

                </td>

              </tr>

            <% } %>

          </tbody>

        </table>

      </div>

    </div>
     <div class="pagination-wrapper d-flex gap-1 align-items-center" id="pagination-container">
        <%- include('../partials/admin/pagination') %>
      </div>


    </div>

  
  </div>

</div>

<script>

  const filterSelect =
    document.querySelector(
      'select[name="reportFilter"]'
    );

  const startDateWrapper =
    document.querySelector(
      'input[name="customStartDate"]'
    ).closest('.col-lg-2');

  const endDateWrapper =
    document.querySelector(
      'input[name="customEndDate"]'
    ).closest('.col-lg-2');

  function toggleCustomDates() {

    const isCustom =
      filterSelect.value === 'Custom';

    startDateWrapper.style.display =
      isCustom ? 'block' : 'none';

    endDateWrapper.style.display =
      isCustom ? 'block' : 'none';

  }

  // INITIAL LOAD

  toggleCustomDates();

  // ON CHANGE

  filterSelect.addEventListener(
    'change',
    toggleCustomDates
  );

</script>



</body>
</html>

