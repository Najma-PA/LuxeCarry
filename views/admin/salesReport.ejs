
<!DOCTYPE html>
<html lang="en">
<head>

<meta charset="UTF-8">
<meta name="viewport"
      content="width=device-width, initial-scale=1.0">

<title>Sales Report</title>

<link
href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<link
rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

<link rel="stylesheet" href="/css/admin.css">

</head>

<body>

<div class="d-flex">

  <%- include('../partials/admin/sidebar',{
    active:'reports'
  }) %>

  <div class="main-content w-100 p-4">

    <!-- HEADER -->
    <div class="report-header mb-4">

      <div>

        <h2 class="report-title mb-1">
          Sales Report
        </h2>

        <p class="report-subtitle mb-0">
          Track orders, revenue and discounts
        </p>

      </div>

      <div class="d-flex gap-2">
        
            <a
            href="/admin/reports/export/pdf?<%= new URLSearchParams(req.query).toString() %>"
            class="btn btn-danger report-btn">

            <i class="fa fa-file-pdf me-2"></i>
            Export PDF

            </a>

            <a
            href="/admin/reports/export/excel?<%= new URLSearchParams(req.query).toString() %>"
            class="btn btn-success report-btn">

            <i class="fa fa-file-excel me-2"></i>
            Export Excel

            </a>

      </div>

    </div>

    <!-- FILTER -->
    <form id="filter-form" >
      <div class="report-filter-card mb-4 " style="border: 2 solid; border-color: rgb(158, 83, 2);">
        <div class="row g-3 align-items-end">
          <!-- SEARCH -->
          <div class="col-lg-4">

            <label class="report-label">
              Search
            </label>

            <input
              type="text"
              name="search"
              value="<%= search || '' %>"
              class="form-control report-input"
              placeholder="Search Order ID">

          </div>

        
          <div class="col-lg-3">

            <label class="report-label">
              Filter
            </label>

            <select
              name="reportFilter"
              class="form-select report-input"> 
                             
                <option value="Today"
                <%= reportFilter === 'Today' ? 'selected' : '' %>>
                Today
                </option>

                <option value="Last 7 Days"
                <%= reportFilter === 'Last 7 Days' ? 'selected' : '' %>>
                Last 7 Days
                </option>
                <option value="Last 30 Days"
                <%= reportFilter === 'Last 30 Days' ? 'selected' : '' %>>
                Last 30 Days
                </option>
                <option value="This Month"
                <%= reportFilter === 'This Month' ? 'selected' : '' %>>
                This Month
                </option>
                <option value="This Year"
                <%= reportFilter === 'This Year' ? 'selected' : '' %>>
                This Year
                </option>
                <option value="Custom"
                <%= reportFilter === 'Custom' ? 'selected' : '' %>>
                Custom Range
                </option>
            </select>
          </div>

          <div class="col-lg-2">
            <label class="report-label">
              From
            </label>
            <input
              type="date"
              name="customStartDate"
              value="<%= customStartDate || '' %>"
              class="form-control report-input">
          </div>

          <div class="col-lg-2">
            <label class="report-label">
              To
            </label>
            <input
              type="date"
              name="customEndDate"
              value="<%= customEndDate || '' %>"
              class="form-control report-input">
          </div>

          
          <div class="col-lg-1">
            <button type="button" id="clear-btn" class="btn btn-secondary w-100" style="background-color: rgb(210, 159, 30);">
              Clear
            </button>
          </div>
        </div>
      </div>
    </form>
<div class="row g-3 mb-4">

 
  <div class="col-xl-3 col-md-6">
    <div class="dashboard-stat-card">

      <div>
        <p class="dashboard-stat-label">
          Total Orders
        </p>

        <h3 id="total-orders" class="dashboard-stat-value">
          <%= summary.totalOrders || 0 %>
        </h3>
      </div>

      <div class="dashboard-stat-icon orders">
        <i class="fa-solid fa-box"></i>
      </div>

    </div>
  </div>

 
   <div class="col-xl-3 col-md-6">
    <div class="dashboard-stat-card">

      <div>
        <p class="dashboard-stat-label">
          Total Sales
        </p>

        <h3 id="total-sales" class="dashboard-stat-value">
          ₹<%= Number(summary.totalSales || 0).toLocaleString() %>
        </h3>
      </div>

      <div class="dashboard-stat-icon revenue">
        <i class="fa-solid fa-wallet"></i>
      </div>

    </div>
  </div>

  <!-- COUPON DISCOUNT 
  <div class="col-xl-3 col-md-6">
    <div class="dashboard-stat-card">

      <div>
        <p class="dashboard-stat-label">
          Coupon Discounts
        </p>

        <h3 class="dashboard-stat-value">
          ₹<%= Number(summary.couponDiscount || 0).toLocaleString() %>
        </h3>
      </div>

      <div class="dashboard-stat-icon users">
        <i class="fa-solid fa-tags"></i>
      </div>

    </div>
  </div>-->
 
  <div class="col-xl-3 col-md-6">
    <div class="dashboard-stat-card">

      <div>
        <p class="dashboard-stat-label">
          Total Refunds
        </p>

        <h3 id="total-refunds" class="dashboard-stat-value text-danger">
          ₹<%= Number(summary.totalRefunds || 0).toLocaleString() %>
        </h3>
      </div>

      <div class="dashboard-stat-icon orders">
        <i class="fa-solid fa-rotate-left"></i>
      </div>

    </div>
  </div>
  
  <div class="col-xl-3 col-md-6">
    <div class="dashboard-stat-card">

      <div>
        <p class="dashboard-stat-label">
          Net Revenue
        </p>

        <h3 id="net-revenue" class="dashboard-stat-value text-success">
          ₹<%= Number(summary.netRevenue || 0).toLocaleString() %>
        </h3>
      </div>

      <div class="dashboard-stat-icon products">
        <i class="fa-solid fa-chart-line"></i>
      </div>

    </div>
  </div>

</div>
    <div class="report-table-card">

      <div class="table-responsive" id="table-container">
        <%- include('../partials/admin/sales-table') %>
      </div>

    </div>
     <div class="pagination-wrapper d-flex gap-1 align-items-center" id="pagination-container">
        <%- include('../partials/admin/pagination') %>
      </div>
    </div>
  </div>

</div>

<script>
  const filterSelect = document.querySelector('select[name="reportFilter"]');
  const startDateInput = document.querySelector('input[name="customStartDate"]');
  const endDateInput = document.querySelector('input[name="customEndDate"]');
  const startDateWrapper = startDateInput.closest('.col-lg-2');
  const endDateWrapper = endDateInput.closest('.col-lg-2');
  const filterForm = document.getElementById('filter-form');
  const searchInput = document.querySelector('input[name="search"]');

  function toggleCustomDates() {
    const isCustom = filterSelect.value === 'Custom';
    startDateWrapper.style.display = isCustom ? 'block' : 'none';
    endDateWrapper.style.display = isCustom ? 'block' : 'none';
    
    // Clear inputs if switching away from Custom
    if (!isCustom) {
      startDateInput.value = '';
      endDateInput.value = '';
    }
  }

  // INITIAL LOAD
  toggleCustomDates();

  // ON CHANGE
  filterSelect.addEventListener('change', () => {
    toggleCustomDates();
    if (filterSelect.value !== 'Custom') {
      fetchSalesData(1);
    }
  });

  // Handle form submission
  filterForm.addEventListener('submit', (e) => {
    e.preventDefault();
  });

  // Handle custom date changes
  startDateInput.addEventListener('change', () => fetchSalesData(1));
  endDateInput.addEventListener('change', () => fetchSalesData(1));

  // Handle Clear Button
  const clearBtn = document.getElementById('clear-btn');
  if (clearBtn) {
    clearBtn.addEventListener('click', () => {
      searchInput.value = '';
      filterSelect.value = 'Today';
      startDateInput.value = '';
      endDateInput.value = '';
      toggleCustomDates();
      fetchSalesData(1);
    });
  }
  
  // Search timeout
  let searchTimeout;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
      fetchSalesData(1);
    }, 500);
  });

  // Pagination handler
  document.addEventListener('click', function(e) {
    const paginationLink = e.target.closest('.pagination-link');
    if (paginationLink) {
      e.preventDefault();
      const href = paginationLink.getAttribute('href');
      if (href) {
        const urlParams = new URLSearchParams(href.split('?')[1]);
        const page = urlParams.get('page') || 1;
        fetchSalesData(page);
      }
    }
  });

  async function fetchSalesData(page = 1) {
    const formData = new FormData(filterForm);
    const searchParams = new URLSearchParams();
    
    // Build query params from form
    for (const [key, value] of formData.entries()) {
      if (value) {
        searchParams.append(key, value);
      }
    }
    searchParams.append('page', page);
    
    const queryString = searchParams.toString();
    const url = `/admin/reports?${queryString}`;
    
    // Update export buttons dynamically
    document.querySelector('.btn-danger.report-btn').href = `/admin/reports/export/pdf?${queryString}`;
    document.querySelector('.btn-success.report-btn').href = `/admin/reports/export/excel?${queryString}`;
    
    
    window.history.pushState({}, '', url);

    try {
      const response = await fetch(url, {
        headers: {
          'X-Requested-With': 'XMLHttpRequest',
          'Accept': 'application/json'
        }
      });
      
      const data = await response.json();
      
      if (data.success) {
        // Update table
        document.getElementById('table-container').innerHTML = data.tableHtml;
        updateSummaryCards(data.summary);
        // Ensure pagination logic uses the returned current page and total pages
        updatePagination(data.currentPage, data.totalPages);
      }
    } catch (error) {
      console.error('Error fetching data:', error);
    }
  }

  function updatePagination(currentPage, totalPages) {
    const paginationContainer = document.getElementById('pagination-container');
    if (!paginationContainer) return;
    
    if (totalPages <= 1) {
      paginationContainer.innerHTML = '';
      return;
    }
    
    let html = '';
    
    // Prev button
    if (currentPage > 1) {
      html += `<a href="?page=${currentPage - 1}" class="page-btn pagination-link" data-page="${currentPage - 1}">
        <i class="fa-solid fa-chevron-left"></i></a>`;
    }
    
    // Pages
    for (let i = 1; i <= totalPages; i++) {
      html += `<a href="?page=${i}" class="page-btn pagination-link ${i === currentPage ? 'active' : ''}" data-page="${i}">${i}</a>`;
    }
    
    // Next button
    if (currentPage < totalPages) {
      html += `<a href="?page=${currentPage + 1}" class="page-btn pagination-link" data-page="${currentPage + 1}">
        <i class="fa-solid fa-chevron-right"></i></a>`;
    }
    
    paginationContainer.innerHTML = html;
  }
 function updateSummaryCards(summary) {

  document.getElementById('total-orders').innerText =
    summary.totalOrders || 0;

  document.getElementById('total-sales').innerText =
    `₹${Number(summary.totalSales || 0).toLocaleString()}`;

  document.getElementById('total-refunds').innerText =
    `₹${Number(summary.totalRefunds || 0).toLocaleString()}`;

  document.getElementById('net-revenue').innerText =
    `₹${Number(summary.netRevenue || 0).toLocaleString()}`;
}
</script>



</body>
</html>

