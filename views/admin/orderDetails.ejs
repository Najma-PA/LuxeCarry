<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport"
content="width=device-width, initial-scale=1.0">

<title>Update Order Status</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
rel="stylesheet">

<link rel="stylesheet"
href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>

<link rel="stylesheet" href="/css/admin.css">
</head>

<body>

<div class="d-flex">

<%- include('../partials/admin/sidebar',
{ active:'orders' }) %>

<div class="main-content w-100 p-5">

    <!-- Header -->
    <div class="mb-4">

        <h2 class="fw-bold mb-1"
        style="color:#0f172a;">

            Order Details & Status

        </h2>

        <p class="text-muted mb-0">

            Order ID:
            #<%= order.orderId %>

        </p>

    </div>

    <!-- Top Grid -->
    <div class="row g-4 mb-4">
    <!-- Products Ordered -->
    <div class="col-lg-9">
    <div class="admin-order-products-card h-100">

        <div class="admin-order-products-header">

            <div class="admin-order-products-title">

                Products Ordered 

            </div>

            <div class="admin-order-products-count">

                <%= order.items.length %> items total

            </div>

        </div>
        <div  class="table-responsive">

        <table class="table admin-order-table align-middle mb-0">

            <thead>

                <tr>

                    <th style="width: 35%;">PRODUCT</th>
                    <th style="width: 8%;">QTY</th>
                    <th style="width: 10%;">PRICE </th>
                    <th style="width: 10%;">COUPON</th>
                    <th style="width: 35%;">STATUS & ACTIONS</th>

                </tr>

            </thead>

            <tbody>

            <% order.items.forEach(item => { %>

            <tr>

                <td>

                    <div class="admin-product-info">

                        <img
                        src="<%= item.productImage || '/images/no-image.png' %>"
                        class="admin-product-image" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px;">

                        <div>

                            <div class="admin-product-name fw-bold" style="color: #0f172a;">

                                <%= item.productName %>

                            </div>

                            <% if(item.variantValue){ %>

                            <div class="admin-product-meta text-muted small mt-1">

                                Variant: <strong><%= item.variantValue %></strong>

                            </div>

                            <% } %>

                        </div>

                    </div>

                </td>

                <td class="fw-bold">

                    × <%= item.quantity %>

                </td>

                <td>

                    <% 
                        let oPrice = item.originalPrice || item.price || 0;
                        let pDisc = item.productDiscount || 0;
                        let fPrice = item.finalPrice || item.price || 0;
                        let tPrice = item.totalPrice ||(item.price * item.quantity) ||0;

                        let cDisc =item.couponDiscount || 0;

                        let fPayable =item.finalPayable ||(tPrice - cDisc);
                        
                    %>
                    <div class="small">
                        <div class="fw-bold d-flex justify-content-between text-dark"><span>₹<%= fPrice.toLocaleString() %></span></div>
                    </div>
                   

                </td>
                <td>

                    

                    <% if(cDisc > 0){ %>

                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2">

                            - ₹<%= cDisc.toFixed(2) %>

                        </span>

                    <% } else { %>

                        <span class="text-muted small">

                            No Coupon

                        </span>

                    <% } %>

                </td>
                
                <td>

                    <div class="d-flex flex-column gap-2">
                        <!-- Current status badge -->
                        <div class="d-flex align-items-center justify-content-between">
                            <%
                            let displayStatus = item.status;

                            let badgeClass =
                                item.status === 'Pending'
                                    ? 'order-pending'
                                    : item.status === 'Confirmed'
                                    ? 'order-processing'
                                    : item.status === 'Shipped' || item.status === 'Out for Delivery'
                                    ? 'order-shipped'
                                    : item.status === 'Delivered'
                                    ? 'order-delivered'
                                    : 'order-cancelled';

                            if (
                                item.requestType === 'Return' &&
                                item.requestStatus === 'Rejected'
                            ) {
                                displayStatus = 'Return Rejected';
                                badgeClass = 'order-cancelled';
                            }
                            %>

                            <span class="order-badge <%= badgeClass %>">
                                <%= displayStatus %>
                            </span>
                            <!-- <span class="order-badge
                                <%= item.status === 'Pending'
                                    ? 'order-pending'
                                    : item.status === 'Confirmed'
                                    ? 'order-processing'
                                    : item.status === 'Shipped' || item.status === 'Out for Delivery'
                                    ? 'order-shipped'
                                    : item.status === 'Delivered'
                                    ? 'order-delivered'
                                    : 'order-cancelled' %>">
                                <%= item.status %>
                            </span> -->
                            <!-- NORMAL STATUS UPDATE -->
                            <%
                            const isLockedStatus =
                                item.status ==='Delivered'||
                                item.status ==='Cancelled'||
                                item.status === 'Returned';
                            %>

                            <% if (!isLockedStatus &&
                                   item.status !== 'Return Requested') { %>

                            <form
                                action="/admin/orders/<%= order._id %>/items/<%= item._id %>/status"
                                method="POST"
                                class="d-flex gap-1 align-items-center status-update-form"
                                >

                                <select
                                    name="status"
                                    class="form-select form-select-sm"
                                    style="width: 160px;">

                                    <% [
                                        'Pending',
                                        'Confirmed',
                                        'Shipped',
                                        'Out for Delivery',
                                        'Delivered'
                                        
                                    ].forEach(st => { %>

                                        <option
                                            value="<%= st %>"
                                            <%= item.status === st ? 'selected' : '' %>>

                                            <%= st %>

                                        </option>

                                    <% }) %>

                                </select>

                                <button
                                    type="submit"
                                    class="btn btn-sm btn-gold">

                                    Update

                                </button>
                                <% if (item.status === 'Pending' || item.status === 'Confirmed') { %>
                                <button type="button" class="btn btn-sm btn-danger ms-1" onclick="openCancelAdminModal('<%= order._id %>', '<%= item._id %>')">
                                    Cancel
                                </button>
                                <% } %>

                            </form>

                            <% } else if (isLockedStatus) { %>

                            <button
                                type="button"
                                class="btn btn-sm btn-secondary"
                                disabled
                                style="opacity:0.6; cursor:not-allowed;">
                                Update 
                            </button>

                            <% } %>
                         
                            <!-- RETURN REQUEST -->
                            <% if(item.status === 'Return Requested') { %>

                            <div class="alert alert-info mt-2 mb-0 small text-dark">

                                <strong>
                                    Return Request
                                </strong>

                                <% if(item.returnReason) { %>

                                    <div class="mt-1">

                                        Reason:
                                        <%= item.returnReason %>

                                    </div>

                                <% } %>

                                <!-- DAMAGE LABEL -->
                                <% if(
                                    item.returnReason &&
                                    item.returnReason.toLowerCase().includes('damage')
                                ) { %>

                                    <div class="text-danger fw-bold mt-1">

                                    </div>

                                <% } %>

                                <div class="d-flex gap-2 mt-2">

                                    <!-- APPROVE -->
                                    <form
                                        action="/admin/orders/<%= order._id %>/item/<%= item._id %>/approve"
                                        method="POST">

                                        <button
                                            type="submit"
                                            class="btn btn-success btn-sm">

                                            Accept

                                        </button>

                                    </form>

                                    <!-- REJECT -->
                
                                     <button
                                            type="submit"
                                            class="btn btn-danger btn-sm"
                                            data-bs-toggle="modal"
                                            data-bs-target="#rejectModal-<%=item._id %>">

                                            Reject

                                    </button>

                                </div>

                            </div>

                            <% } %>
                            
                        </div>

                        <!-- Cancellation Reason -->
                        <% if (item.status === 'Cancelled' && item.cancelReason) { %>
                            <div class="alert alert-danger p-2 mb-0 mt-1 small">
                                <strong>Cancel Reason:</strong> <%= item.cancelReason %>
                                <% if (item.cancelledAt) { %>
                                    <div class="text-muted text-end mt-1" style="font-size: 10px;">At: <%= new Date(item.cancelledAt).toLocaleString() %></div>
                                <% } %>
                            </div>
                        <% } %>

                        <!-- Return Reason -->
                        <% if (item.status === 'Returned' && item.returnReason) { %>
                            <div class="alert alert-warning p-2 mb-0 mt-1 small text-dark">
                                <strong>Return Reason:</strong> <%= item.returnReason %>
                                <% if (item.returnedAt) { %>
                                    <div class="text-muted text-end mt-1" style="font-size: 10px;">At: <%= new Date(item.returnedAt).toLocaleString() %></div>
                                <% } %>
                            </div>
                        <% } %>
                           <!--Rejected Reason-->
                           <%if (
                            item.requestStatus ==='Rejected'
                           ) {%>
                            <div class="alert alert-danger p-2 mb-0 mt-1 small">
                                <strong>Return Rejected</strong><br>
                                Reason:
                                <%= item.adminResponse || 'No reason provided' %>
                                <%if(item.requestProcessedAt){%>
                                    <div class="text-muted text-end mt-1 " style="font: size 10px;">
                                        At:
                                        <%= new Date(item.requestProcessedAt).toLocaleString()%>
                                        </div>
                                <%}%>
                            </div>
                            

                          <% } %>
                          <%if(
                            item.status ==='Cancelled'||
                            item.status ==='Returned'
                          ){%>
                        <div class="bg-light p-2 rounded mt-1 border">

                            <div class="d-flex justify-content-between align-items-center mb-1">

                                <span class="small text-muted">
                                    Refund Amount:
                                </span>

                                <span class="fw-bold small text-dark">

                                    ₹<%= (item.finalPayable || 0)
                                        .toLocaleString() %>

                                </span>

                            </div>

                            <div class="d-flex justify-content-between align-items-center">

                                <span class="small text-muted">
                                    Refund Status:
                                </span>

                                <span class="
                                    badge
                                    <%= item.refundStatus === 'Processed'
                                    ? 'bg-success'
                                    : 'bg-secondary' %>
                                ">

                                    <%= item.refundStatus %>

                                </span>

                            </div>

                        </div>
                        <%}%>
                    </div>

                </td>

            </tr>
            <div
                class="modal fade"
                id="rejectModal-<%= item._id %>"
                tabindex="-1"
                aria-hidden="true"
                >
                
                <div class="modal-dialog">

                    <div class="modal-content">

                    <div class="modal-header">

                        <h5 class="modal-title">
                        Reject Return Request
                        </h5>

                        <button
                        type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        ></button>

                    </div>

                    <form id="rejectForm-<%=item._id %>"
                        action="/admin/orders/<%= order._id %>/item/<%= item._id %>/reject"
                        method="POST"
                    >

                        <div class="modal-body">

                        <label class="form-label">
                            Rejection Reason
                        </label>

                        <textarea
                            name="adminResponse"
                            class="form-control reject-reason"
                            rows="4"
                            placeholder="Enter rejection reason..."
                        required   
                        ></textarea>
                        <p  class="text-danger mt-2 small reject-error
                        "></p>
                        </div>

                        <div class="modal-footer">

                        <button
                            type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal"
                        >
                            Cancel
                        </button>

                        <button
                            type="submit"
                            class="btn btn-danger"
                        >
                            Reject Request
                        </button>

                        </div>

                    </form>

                    </div>

                </div>

                </div>

            <% }) %>
            <tr class="border-0">

                <td></td>

                <td></td>

                
                <td colspan="2"class="pt-4">

                    <div class="d-flex
                                justify-content-end
                                align-items-center
                                gap-4
                                fw-bold fs-5">

                        <div>

                            Grand Total :
                            <%
                            const activeTotal=order.items.reduce((total,item)=>{
                                if(
                                    item.status !=='Cancelled' && item.status !=='Returned'
                                ){
                                    return total+(item.finalPayable|| 0)
                                }
                                return total;
                            },0)
                            %>
                        
                            <span class="ms-1 text-dark">

                                ₹<%= activeTotal.toFixed(2) %>

                            </span>

                        </div>


                    </div>

                </td>

            </tr>


            </tbody>

        </table>
        </div>

       
    </div>
    </div>
    <!--customer details-->
     <div class="col-lg-3">
        <div class="admin-order-detail-card h-100 ">
            
            <h3 class="admin-order-card-title">

                Customer & Shipping

            </h3>

            <div class="mb-4">

                <div class="admin-order-label">
                    Customer
                </div>

                <div class="admin-order-text">

                    <strong><%= order.userId?.name || 'Customer' %></strong><br>
                    <%= order.userId?.email || '' %>

                </div>

            </div>

            <div>

                <div class="admin-order-label">
                    Shipping Address
                </div>

                <div class="admin-order-text">

                    <i class="fa-solid fa-location-dot me-2"
                    style="color:#c26a00;"></i>

                    <%= order.shippingAddress.name %><br>
                    <%= order.shippingAddress.street %>,
                    <br>

                    <%= order.shippingAddress.city %>,
                    <%= order.shippingAddress.state %>

                    -
                    <%= order.shippingAddress.pincode %>

                    <br>

                    <%= order.shippingAddress.country %><br>
                    Phone: <%= order.shippingAddress.phone %>

                </div>

            </div>

        </div>

    </div>

    </div>

</div>

</div>

<%- include('../partials/flashAndToast') %>
<script>
async function confirmSubmit(event, message) {
    event.preventDefault();
    const form = event.target;
    const result = await window.showConfirm('Confirm Action', message);
    if (result.isConfirmed) {
        form.submit();
    }
}


document.addEventListener('DOMContentLoaded', () => {

    const rejectForms =
        document.querySelectorAll('[id^="rejectForm-"]');

    rejectForms.forEach(form => {

        const textarea =
            form.querySelector('.reject-reason');

        const errorBox =
            form.querySelector('.reject-error');

        // LIVE VALIDATION
        textarea.addEventListener('input', () => {

            if (textarea.value.trim()) {

                errorBox.textContent = '';

                textarea.classList.remove('is-invalid');
            }

        });

        form.addEventListener('submit', function(e) {

            errorBox.textContent = '';

            textarea.classList.remove('is-invalid');

            if (!textarea.value.trim()) {

                e.preventDefault();

                errorBox.textContent =
                    'Please enter rejection reason';

                textarea.classList.add('is-invalid');

                return;

            }

        });

    });

});

function toggleAdminCancelTextarea() {
    const select = document.getElementById('adminCancelReasonSelect');
    const textareaGroup = document.getElementById('adminCancelTextareaGroup');
    const textarea = document.getElementById('adminCancelReasonText');
    if (select.value === 'Other') {
        textareaGroup.style.display = 'block';
        textarea.required = true;
    } else {
        textareaGroup.style.display = 'none';
        textarea.required = false;
        textarea.value = '';
    }
}

function openCancelAdminModal(orderId, itemId) {
    const form = document.getElementById('cancelAdminItemForm');
    form.action = `/admin/orders/${orderId}/items/${itemId}/status`;
    const modal = new bootstrap.Modal(document.getElementById('cancelAdminItemModal'));
    modal.show();
}

document.getElementById('cancelAdminItemForm')?.addEventListener('submit', function(e) {
    const selectValue = document.getElementById('adminCancelReasonSelect').value;
    const textValue = document.getElementById('adminCancelReasonText').value;
    const finalReason = selectValue === 'Other' ? textValue : selectValue;
    document.getElementById('finalAdminCancelReason').value = finalReason;
    
    e.preventDefault();
    Swal.fire({
        title: 'Are you sure?',
        text: "This item will be cancelled and stock will be restored.",
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#d33',
        cancelButtonColor: '#3085d6',
        confirmButtonText: 'Yes, cancel it!'
    }).then((result) => {
        if (result.isConfirmed) {
            this.submit();
        }
    });
});
</script>

<!-- Admin Cancellation Modal -->
<div class="modal fade" id="cancelAdminItemModal" tabindex="-1" aria-labelledby="cancelAdminItemModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="cancelAdminItemModalLabel">Cancel Order Item</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="cancelAdminItemForm" method="POST">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="adminCancelReasonSelect" class="form-label">Cancellation Reason <span class="text-danger">*</span></label>
                        <select class="form-select" id="adminCancelReasonSelect" name="cancelReasonSelect" required onchange="toggleAdminCancelTextarea()">
                            <option value="">Select a reason</option>
                            <option value="Product Out of Stock">Product Out of Stock</option>
                            <option value="Damaged Inventory">Damaged Inventory</option>
                            <option value="Pricing Error">Pricing Error</option>
                            <option value="Supplier Issue">Supplier Issue</option>
                            <option value="Duplicate Order">Duplicate Order</option>
                            <option value="Fraudulent Order">Fraudulent Order</option>
                            <option value="Customer Requested Cancellation">Customer Requested Cancellation</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="mb-3" id="adminCancelTextareaGroup" style="display: none;">
                        <label for="adminCancelReasonText" class="form-label">Please specify <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="adminCancelReasonText" name="cancelReasonText" rows="3"></textarea>
                    </div>
                    <input type="hidden" name="status" value="Cancelled">
                    <input type="hidden" id="finalAdminCancelReason" name="cancelReason">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" class="btn btn-danger">Confirm Cancellation</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>