<!-- USER SIDEBAR PARTIAL -->
<style>
    .dashboard-page-header {
        margin-bottom: 2rem;
        border-bottom: 1px solid #f1f5f9;
        padding-bottom: 1rem;
    }
    
    .dashboard-page-title {
        font-size: 2rem;
        font-weight: 700;
        color: #0f172a;
        margin-bottom: 0.25rem;
    }
    
    .dashboard-page-subtitle {
        color: #64748b;
        font-size: 0.95rem;
        margin: 0;
    }
    .account-container,
    .row,
    .col-lg-3,
    .col-md-4 {
        overflow: visible !important;
    }

    .user-dashboard-sidebar {
        position: sticky;
        top: 110px;
        align-self: flex-start;
        z-index: 100;
        height: fit-content;
    }

    @media (max-width: 991px) {
        .user-dashboard-sidebar {
            position: fixed !important;
            top: 0 !important;
            left: 0;
            width: 280px;
            height: 100vh;
            background: #fff;
            z-index: 1050 !important;
            transform: translateX(-100%);
            transition: transform 0.3s ease-in-out;
            overflow-y: auto;
            margin-bottom: 0 !important;
            padding: 20px 15px;
            box-shadow: 2px 0 10px rgba(0,0,0,0.1);
        }
        .user-dashboard-sidebar.show {
            transform: translateX(0);
        }
        .user-sidebar-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100vh;
            background: rgba(0,0,0,0.4);
            z-index: 1045;
            display: none;
            transition: opacity 0.3s ease;
        }
        .user-sidebar-overlay.show {
            display: block;
        }
    }
</style>

<!-- Mobile Toggle Button (Visible only on lg and down) -->
<div class="col-12 d-lg-none mb-3">
    <div class="d-flex align-items-center justify-content-between bg-white p-3 rounded shadow-sm border" style="margin-top: 20px;">
        <span class="fw-bold fs-6"><i class="fa fa-user-circle me-2" style="color: #c26a00"></i> Account Menu</span>
        <button class="btn btn-outline-secondary btn-sm" id="userSidebarToggleBtn">
            <i class="fa fa-bars"></i>
        </button>
    </div>
</div>

<!-- Sidebar Drawer Overlay -->
<div class="user-sidebar-overlay d-lg-none" id="userSidebarOverlay"></div>

<div class="col-lg-3 col-md-4 mb-4 user-dashboard-sidebar" id="userSidebar">
  <!-- Close Button for Mobile -->
  <button class="btn btn-light d-lg-none position-absolute top-0 end-0 m-3" id="userSidebarCloseBtn" style="z-index: 1051; border-radius: 50%;">
    <i class="fa fa-times"></i>
  </button>

  <div class="lc-sidebar-card">
    
    <!-- User Profile Header -->
    <div class="d-flex align-items-center lc-sidebar-header">
      <%- include('./avatar', { targetUser: user, size: 48, className: 'lc-sidebar-avatar me-3' }) %>
      <div class="overflow-hidden">
        <h6 class="mb-0 text-truncate lc-sidebar-name" title="<%= user.name %>"><%= user.name %></h6>
        <small class="text-muted text-truncate d-block small" style="font-size: 0.8rem;" title="<%= user.email %>"><%= user.email %></small>
      </div>
    </div>

    <!-- Sidebar Menu Options -->
    <ul class="lc-sidebar-menu">
      <li class="lc-sidebar-menu-item <%= locals.activePage === 'profile' ? 'active' : '' %>">
        <a href="/user/profile" class="lc-sidebar-menu-link">
          <i class="fa fa-user"></i> <span>Profile Settings</span>
        </a>
      </li>

      <li class="lc-sidebar-menu-item <%= locals.activePage === 'orders' ? 'active' : '' %>">
        <a href="/user/orders" class="lc-sidebar-menu-link">
          <i class="fa fa-box"></i> <span>My Orders</span>
        </a>
      </li>

      <li class="lc-sidebar-menu-item <%= locals.activePage === 'wishlist' ? 'active' : '' %>">
        <a href="/user/wishlist" class="lc-sidebar-menu-link">
          <i class="fa fa-heart"></i> <span>Wishlist</span>
        </a>
      </li>

      <li class="lc-sidebar-menu-item <%= locals.activePage === 'addresses' ? 'active' : '' %>">
        <a href="/user/addresses" class="lc-sidebar-menu-link">
          <i class="fa fa-location-dot"></i> <span>Addresses</span>
        </a>
      </li>


      <li class="lc-sidebar-menu-item <%= locals.activePage === 'coupons' ? 'active' : '' %>">
        <a href="/user/coupons" class="lc-sidebar-menu-link">
          <i class="fa fa-ticket"></i> <span>Coupons</span>
        </a>
      </li>

      <li class="lc-sidebar-menu-item <%= locals.activePage === 'wallet' ? 'active' : '' %>">
        <a href="/user/wallet" class="lc-sidebar-menu-link ">
          <i class="fa fa-wallet"></i> <span>My Wallet</span>
        </a>
      </li>

      <li class="lc-sidebar-menu-item <%= locals.activePage === 'referral' ? 'active' : '' %>">
        <a href="/user/referral" class="lc-sidebar-menu-link ">
          <i class="fa fa-gift"></i> <span>Refer & Earn</span>
        </a>
      </li>
    </ul>

    <div class="lc-sidebar-divider"></div>

    <!-- Logout -->
    <a href="/user/logout" class="lc-sidebar-logout-link">
      <i class="fa fa-sign-out"></i> <span>Logout</span>
    </a>

  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const sidebar = document.getElementById('userSidebar');
    const toggleBtn = document.getElementById('userSidebarToggleBtn');
    const closeBtn = document.getElementById('userSidebarCloseBtn');
    const overlay = document.getElementById('userSidebarOverlay');

    if (toggleBtn && sidebar) {
      toggleBtn.addEventListener('click', () => {
        sidebar.classList.add('show');
        if (overlay) overlay.classList.add('show');
      });
    }

    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', () => {
        sidebar.classList.remove('show');
        if (overlay) overlay.classList.remove('show');
      });
    }

    if (overlay && sidebar) {
      overlay.addEventListener('click', () => {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
      });
    }
  });
</script>
