<!-- Mobile Header Wrapper -->
<div
  class="d-lg-none position-fixed top-0 start-0 w-100 bg-white border-bottom d-flex align-items-center justify-content-between p-3"
  style="z-index: 1040; height: 70px"
>
  <a
    href="/admin/dashboard"
    class="text-dark text-decoration-none fw-bold d-flex align-items-center fs-5"
  >
    <i class="fa-solid fa-bag-shopping me-2" style="color: #c26a00"></i> LuxeCarry
  </a>
  <button class="btn btn-outline-secondary" id="sidebarToggleBtn">
    <i class="fa fa-bars"></i>
  </button>
</div>

<!-- Sidebar Drawer Overlay -->
<div class="admin-sidebar-overlay d-lg-none" id="sidebarOverlay"></div>

<div class="admin-sidebar d-flex flex-column justify-content-between" id="adminSidebar">
  <!-- Close Button for Mobile -->
  <button
    class="btn btn-light d-lg-none position-absolute top-0 end-0 m-3"
    id="sidebarCloseBtn"
    style="z-index: 1051"
  >
    <i class="fa fa-times"></i>
  </button>

  <!-- TOP -->
  <div>
    <div class="logo p-3">
      <a
        href="/admin/dashboard"
        class="text-dark text-decoration-none fw-bold d-flex align-items-center fs-5"
      >
        <i class="fa-solid fa-bag-shopping me-2" style="color: #c26a00"></i>
        LuxeCarry
      </a>
      <small class="text-muted ms-4 ps-1">Admin</small>
    </div>

    <ul class="nav flex-column mt-4">
      <li class="nav-item">
        <a href="/admin/dashboard" class="nav-link <%= active === 'dashboard' ? 'active' : '' %>">
          <i class="fa fa-home"></i> Dashboard
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/users" class="nav-link <%= active === 'users' ? 'active' : '' %>">
          <i class="fa fa-users"></i> Users
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/products" class="nav-link <%= active === 'inventory' ? 'active' : '' %>">
          <i class="fa fa-box"></i> Inventory
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/categories" class="nav-link <%= active === 'categories' ? 'active' : '' %>">
          <i class="fa fa-tags"></i> Categories
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/banners" class="nav-link <%= active === 'banners' ? 'active' : '' %>">
          <i class="fa fa-image"></i> Add Banners
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/coupons" class="nav-link <%= active === 'coupons' ? 'active' : '' %>">
          <i class="fa fa-ticket"></i> Coupons
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/orders" class="nav-link <%= active === 'orders' ? 'active' : '' %>">
          <i class="fa fa-shopping-cart"></i> Orders
        </a>
      </li>

      <li class="nav-item">
        <a href="/admin/reports" class="nav-link <%= active === 'reports' ? 'active' : '' %>">
          <i class="fa fa-chart-bar"></i> Sales Report
        </a>
      </li>
    </ul>
  </div>

  <!-- BOTTOM -->
  <div class="p-3">
    <form action="/admin/logout" method="POST">
      <button class="btn btn-outline-danger w-100 mb-3">
        <i class="fa fa-sign-out-alt"></i> Logout
      </button>
    </form>

    <div class="admin-info d-flex align-items-center">
      <div>
        <small><%= admin?.email || "Admin" %></small>
      </div>
    </div>
  </div>
</div>
<script>
  window.addEventListener('pageshow', function (event) {
    if (event.persisted) {
      window.location.reload();
    }
  });

  document.addEventListener('DOMContentLoaded', () => {
    const sidebar = document.getElementById('adminSidebar');
    const toggleBtn = document.getElementById('sidebarToggleBtn');
    const closeBtn = document.getElementById('sidebarCloseBtn');
    const overlay = document.getElementById('sidebarOverlay');

    if (toggleBtn && sidebar) {
      toggleBtn.addEventListener('click', () => {
        sidebar.classList.add('show');
        if (overlay) overlay.classList.add('show');
      });
    }

    if (closeBtn && sidebar) {
      closeBtn.addEventListener('click', () => {
        sidebar.classList.remove('show');
        if (overlay) overlay.classList.remove('show');
      });
    }

    if (overlay && sidebar) {
      overlay.addEventListener('click', () => {
        sidebar.classList.remove('show');
        overlay.classList.remove('show');
      });
    }
  });
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
